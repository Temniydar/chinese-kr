@echo off
chcp 65001 > nul
title Китайский язык — Подготовка к КР (Билеты 1-12)
echo ========================================================
echo   Запуск интерактивного тренажёра по китайскому языку
echo   Билеты 1-12 • Озвучка • Проверка • Работа над ошибками
echo ========================================================
echo.

:: Переходим в директорию скрипта
cd /d "%~dp0"

:: Проверяем наличие python для локального сервера
where python >nul 2>&1
if %ERRORLEVEL% equ 0 (
    echo Запуск локального веб-сервера на порту 8088...
    start "" python -m http.server 8088
    timeout /t 1 /nobreak > nul
    start "" http://localhost:8088
) else (
    echo Открытие тренажера напрямую в браузере...
    start "" "%~dp0index.html"
)

echo.
echo Тренажёр успешно запущен в вашем браузере!
echo Приятной и продуктивной подготовки к контрольной работе!
echo.
pause
